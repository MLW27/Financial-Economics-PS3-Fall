import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

gamma = 5.0 #risk aversion
beta = 0.95 #discount factor
T = 5 #number of periods
r = 0.015 #riskless rate
mu = 0.065 #equity premium
sig = 0.18 #standard deviation
agents = 10000
w_0 = 10
wealth = np.zeros((agents,T))
share = np.zeros((agents,T))
consumptions = np.zeros((agents,T))
wealth[:,0] = w_0
#Wealth Grid
maxw = np.log(50.0)
minw = np.log(1.0)
nw = 50
gw = np.linspace(minw,maxw,nw) #log-wealth grid
egw = np.exp(gw) #wealth grid in levels
na = 21
ga = np.linspace(0,1,na)
a = np.zeros((nw,T))
nc = 25
c = np.zeros((nw, T))
v = np.zeros((nw, T))

#quadrature
nqp = 3
gret = np.full(nqp, mu+r)
gret[0] = gret[0] - 1.73205080756887 * sig
gret[2] = gret[2] + 1.73205080756887 * sig
weight = np.array([0.1666666666666667, 0.666666666666667, 0.1666666666666667])

#Final Period
c[:, T-1] = np.exp(gw)
v[:, T-1] = (c[:, T-1] **(1-gamma)) / (1-gamma)
#other periods
for i in range (T-2, -1, -1):
    spline_v = CubicSpline(gw, v[:, i+1],bc_type = "not-a-knot")
    for z in range(nw):
        gc = np.linspace(0.001, 0.999*c[z,i+1],nc)
        auxV = np.zeros((nc,na))
        for j in range(nc):
            sav = np.exp(gw[z]) - gc[j]
            for k in range(na):
                ev = 0.0
                for q in range(nqp):
                    w_t1 = np.log((ga[k]*(1.0+gret[q]) + (1-ga[k])*(1.0+r)) * sav)
                    w_t1 = np.clip(w_t1, np.log(0.0001),maxw) #truncate
                    ev += weight[q] * spline_v(w_t1)
                auxV[j,k] = (gc[j]**(1-gamma)) / (1-gamma) +beta*ev
        jmax, kmax = np.unravel_index(auxV.argmax(), auxV.shape)
        v[z,i] = auxV[jmax,kmax]
        c[z,i] = gc[jmax]
        a[z,i] = ga[kmax]
np.random.seed(163)
mean_r = 1.0 + mu + r
print(mean_r)
for t in range(T):
    consumptions[:,t] = np.interp(wealth[:,t],egw,c[:,t])
    share[:,t] = np.interp(wealth[:,t],egw,a[:,t])
    R = np.random.normal(mean_r,sig,agents)
    if t < T-1:
        wealth[:,t+1] = (share[:,t]*R + (1.0-share[:,t])*(1.0+r))*(wealth[:,t]-consumptions[:,t])

avg_consumption = consumptions.mean(axis=0)
avg_wealth      = wealth.mean(axis=0)
avg_share       = share[:, :T-1].mean(axis=0)   # periods 1-4 only

print("Period:", [1, 2, 3, 4, 5])
print("Average consumption:", np.round(avg_consumption, 3))
print("Average wealth:     ", np.round(avg_wealth, 3))
print("Average share (periods 1-4):", np.round(avg_share, 3))
plt.figure()
for t in range(T):
    plt.plot(egw, c[:, t], label=f"Period {t+1}")
plt.xlabel("Wealth"); plt.ylabel("Consumption")
plt.title("Consumption Policy Functions"); plt.legend(); plt.savefig("consumption_policy.png",bbox_inches="tight");plt.show()

plt.figure()
for t in range(T-1):          # no portfolio choice in the last period
    plt.plot(egw, a[:, t], label=f"Period {t+1}")
plt.xlabel("Wealth"); plt.ylabel("Share in risky asset")
plt.title("Portfolio Policy Functions"); plt.legend();plt.savefig('portfolio_policy.png',bbox_inches ="tight");plt.show()


rows = [0, 10, 25, 49]
print("Wealth levels:", np.round(egw[rows], 2))
print("Consumption (rows = wealth levels, columns = periods 1-5):")
print(np.round(c[rows, :], 3))
print("Risky share (rows = wealth levels, columns = periods 1-5):")
print(np.round(a[rows, :], 3))
